start : program

program : "program" ID "{" var_section statement "}"

var_section : var_decl*
var_decl    : "var" ID ("," ID)* ":" type_of ";"

type_of : TYPE
TYPE    : "int" | "float" | "string" | "bool"

statement  : "begin" ";" stmt_block "end" ";"
stmt_block : stmt*

stmt : assignment
     | if_stmt
     | while_stmt
     | for_stmt
     | write_stmt
     | return_stmt
     | increment ";"
     | proc_call ";"

assignment : ID ":=" expr ";"
increment  : ID INCR_OP
INCR_OP    : "++" | "--"

if_stmt    : "if" "(" expr ")" "then" block ("else" block)?
while_stmt : "while" "(" expr ")" "do" block
for_stmt   : "for" "(" for_init ";" expr ";" for_update ")" block

for_init   : ID ":=" expr
for_update : increment
           | assignment

block : "{" stmt* "}"

write_stmt  : "write" "(" expr ("," expr)* ")" ";"
return_stmt : "return" expr ";"

proc_call : ID "(" arg_list? ")"
arg_list  : expr ("," expr)*

expr     : expr_or
expr_or  : expr_and ("or"  expr_and)*
expr_and : expr_not ("and" expr_not)*
expr_not : "not" expr_not
         | expr_rel

expr_rel : expr_add (op_rel expr_add)?

op_rel : REL_OP
REL_OP : ">=" | "<=" | "==" | "!=" | ">" | "<"

expr_add  : expr_mult (ADD_OP expr_mult)*
ADD_OP    : "+" | "-"

expr_mult : factor (MUL_OP factor)*
MUL_OP    : "*" | "/" | "%"

factor : NUMBER
       | FLOAT
       | STRING
       | BOOL_LIT
       | proc_call
       | ID
       | "(" expr ")"
       | UMINUS factor

BOOL_LIT : "true" | "false"
UMINUS   : "-"

ID     : /[A-Za-z][A-Za-z0-9_]*/
NUMBER : /[0-9]+/
FLOAT  : /[0-9]+\.[0-9]+/
STRING : /\"[^\"]*\"/

%ignore /[ \t\n\r]+/
%ignore /\/\/[^\n]*/
